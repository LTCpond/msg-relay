<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ltcpond.msgrelay.reliability.repository.MessageReadMapper">

    <update id="updateStatus">
        UPDATE t_message SET status = #{status}, updated_at = NOW() WHERE msg_id = #{msgId} AND deleted = 0
    </update>

</mapper>
